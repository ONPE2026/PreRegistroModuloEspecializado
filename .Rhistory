#Envío final
library(rio)
library(dplyr)
data<-rio::import("~/ONPE/Envío setiembre/Data-setiembreERM.csv")
#=================
#BOUNCE
#=================
bounce<-import("~/ONPE/Envío Final - ERM/Bounce_21092026_23092026_ERM2026.xlsx") %>%
select("CORREO"=mail_destinations) %>%
mutate(CORREO=toupper(CORREO))
data_sin_rebotes<- data%>%
filter(!CORREO %in% bounce$CORREO)
#quitar a waltergama y a jairo40@gmail.com
desus<-rio::import("~/ONPE/Envío Final-ERM/Desuscripcion_2909.xlsx",sheet="Hoja1")|>
mutate(CORREO=toupper(CORREO))
#quitar a waltergama y a jairo40@gmail.com
desus<-rio::import("~/ONPE/Envío Final - ERM/Desuscripcion_2909.xlsx",sheet="Hoja1")|>
mutate(CORREO=toupper(CORREO))
data_final<-data_sin_rebotes %>%
mutate(CORREO=trimws(data_sin_rebotes$CORREO)) |>
filter(!CORREO %in% trimws(desus$CORREO))
nrow(data_sin_rebotes)-nrow(data_final)
nunca=c("jairo40@gmail.com","waltgama@hotmail.com")
data_final2=data_final |>
filter(!CORREO %in% c(nunca))
nrow(data_final)-nrow(data_final2)
nrow(data_sin_rebotes)-nrow(data_final)
nrow(data)-nrow(data_sin_rebotes)
data_final_vf<-data_final2 |> distinct()
nrow(data_final_vf)-nrow(data_final2)
#===================
#EXPORTAR
#===================
export(data_final_vf,"~/ONPE/Envío Final - ERM/Data-ERM-Final.csv")
n <- 999999
filas <- nrow(data_final_vf)
lista <- split(data_final_vf,
rep(1:ceiling(filas/n), each=n, length.out=filas))
Consolidado1=lista$`1`
Consolidado2=lista$`2`
Consolidado3=lista$`3`
Consolidado4=lista$`4`
Consolidado5=lista$`5`
export(Consolidado1,"~/ONPE/Envío Final - ERM/consolidado1.xlsx")
export(Consolidado2,"~/ONPE/Envío Final - ERM/consolidado2.xlsx")
export(Consolidado3,"~/ONPE/Envío Final - ERM/consolidado3.xlsx")
export(Consolidado4,"~/ONPE/Envío Final - ERM/consolidado4.xlsx")
export(Consolidado5,"~/ONPE/Envío Final - ERM/consolidado5.xlsx")
